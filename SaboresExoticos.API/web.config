<?xml version="1.0" encoding="utf-8"?>
<!-- 
  web.config para IIS con ASP.NET Core (InProcess hosting)
  Copiar este archivo en la carpeta de publicación.
-->
<configuration>
	<location path="." inheritInChildApplications="false">
		<system.webServer>

			<handlers>
				<!-- Módulo ASP.NET Core para IIS -->
				<add name="aspNetCore"
					 path="*"
					 verb="*"
					 modules="AspNetCoreModuleV2"
					 resourceType="Unspecified" />
			</handlers>

			<aspNetCore
				processPath="dotnet"
				arguments=".\SaboresExoticos.API.dll"
				stdoutLogEnabled="true"
				stdoutLogFile=".\logs\stdout"
				hostingModel="inprocess">
				<environmentVariables>
					<environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
				</environmentVariables>
			</aspNetCore>

			<!-- Seguridad básica: ocultar versión del servidor -->
			<security>
				<requestFiltering removeServerHeader="true" />
			</security>

			<!-- Compresión de respuestas -->
			<urlCompression doStaticCompression="true" doDynamicCompression="true" />

		</system.webServer>
	</location>
</configuration>
